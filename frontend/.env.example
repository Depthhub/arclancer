# ArcLancer Frontend Environment Variables
# Copy this file to .env.local and fill in the values
# Docs: https://docs.arc.network/arc/references/contract-addresses

# ============ REQUIRED ============

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Factory Address — Deploy your own with: npx hardhat run scripts/deploy.ts --network arcTestnet
NEXT_PUBLIC_FACTORY_ADDRESS=

# Contract Addresses (Arc Testnet — official addresses)
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
NEXT_PUBLIC_STABLEFX_ADDRESS=0x1f91886C7028986aD885ffCee0e40b75C9cd5aC1

# ============ OPTIONAL ============

# IPFS — Pinata (get a free key at https://app.pinata.cloud)
NEXT_PUBLIC_PINATA_JWT=
NEXT_PUBLIC_PINATA_GATEWAY=

# RPC URLs (defaults are configured in wagmi.ts)
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Arc Testnet Chain ID: 5042002
# Block Explorer: https://testnet.arcscan.app
# Faucet: https://faucet.circle.com

# ============ ANALYTICS (Optional) ============

# Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ============ ERROR TRACKING (Optional) ============

# Sentry
NEXT_PUBLIC_SENTRY_DSN=

# ============ CCTP BRIDGE UI (Optional) ============

# Enable Circle CCTP bridge modal + dashboard cards (mock/simulated flow for demos)
# Set to true for grant videos and local testing; leave unset/false in production until Bridge Kit is integrated
NEXT_PUBLIC_CCTP_UI_ENABLED=true

# ============ AGENT MARKETPLACE (Optional) ============

# Enable AI agent marketplace, create agent, and dashboard tabs
NEXT_PUBLIC_AGENTS_UI_ENABLED=true
NEXT_PUBLIC_REGISTRY_ADDRESS=0x28c87a31a6e608dbf90839d10567ed44e7e3bbd1
