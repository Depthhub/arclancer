# Circle Programmable Wallets (Arc Testnet)
# Get credentials: https://console.circle.com → Wallets → User Controlled
CIRCLE_API_KEY=
NEXT_PUBLIC_CIRCLE_APP_ID=
NEXT_PUBLIC_CIRCLE_WALLETS_ENABLED=true
ARC_NETWORK=testnet
# Mainnet only: hosted Circle Payment Gateway checkout URL
CIRCLE_PAYMENT_GATEWAY_URL=
NEXT_PUBLIC_CHATGPT_INSTALL_URL=https://chatgpt.com/plugins

# Optional: disable Circle and fall back to RainbowKit/MetaMask
# NEXT_PUBLIC_CIRCLE_WALLETS_ENABLED=false

# Existing ArcLancer env (see DigitalOcean app config)
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_FACTORY_ADDRESS=0x0ADf70A390868c7016697edF0640791c3B3e5f31
NEXT_PUBLIC_REGISTRY_ADDRESS=0x28c87a31a6e608dbf90839d10567ed44e7e3bbd1
